# =============================================================================
# HemoVet — Plantilla de variables de entorno LOCAL
# =============================================================================
# Instrucciones:
#   1. Copiar este archivo: cp .env.example .env
#   2. Ajustar credenciales remotas solo si vas a usar esos servicios
#   3. Nunca subir el .env resultante al repositorio
#
# Entorno objetivo: desarrollo local con Docker Compose
# =============================================================================

# Desarrollo local = aplicación base + Ollama local. El runtime GPU dedicado
# usa su propio archivo y nunca se combina con este stack.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=hemovet
POSTGRES_USER=hemovet
POSTGRES_PASSWORD=hemovet_dev_2026
DATABASE_URL=postgresql://hemovet:hemovet_dev_2026@db:5432/hemovet

# -----------------------------------------------------------------------------
# Seguridad del backend
# -----------------------------------------------------------------------------
APP_ENV=development
PROJECT_NAME=VetCDSS API
HEMOVET_PROJECT_ROOT=/app
HEMOVET_API_VERSION=2.1.0
# Identificador público de la imagen; usar el SHA corto y añadir -dirty si aplica.
HEMOVET_BUILD_REVISION=dev
HEMOVET_SCHEMA_VERSION=3.0.0
API_V1_PREFIX=/api/v1

# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me-please-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Salt para anonimización de IDs de mascotas
# Generar con: python3 -c "import secrets; print(secrets.token_hex(16))"
HEMOVET_DOG_ID_SALT=dev-dog-id-salt-change-me-2026

# Correos con acceso al panel técnico (separados por coma)
ADMIN_EMAILS=admin@example.com

# OpenTelemetry es opt-in en desarrollo. Al activarlo, el SDK exporta por
# OTLP/HTTP y nunca incluye prompts ni identificadores clínicos sin anonimizar.
OTEL_ENABLED=0
OTEL_SERVICE_NAME=hemovet-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_IDENTIFIER_HMAC_SECRET=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_FASTAPI_INSTRUMENTATION_ENABLED=1

# -----------------------------------------------------------------------------
# CORS — orígenes permitidos
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000
CADDY_SITE_ADDRESS=localhost
CADDY_WWW_ADDRESS=www.localhost

# -----------------------------------------------------------------------------
# Semilla de datos de demostración para entorno local.
# -----------------------------------------------------------------------------
HEMOVET_SEED_DEMO_HISTORY=1
BACKEND_WEB_CONCURRENCY=1
HEMOVET_ANALYSIS_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Artefactos ML locales
# -----------------------------------------------------------------------------
INSTALL_LOCAL_ML=1
HEMOVET_ENABLE_LOCAL_ML=1
HEMOVET_ARTIFACT_MANIFEST_PATH=data/processed/artifact_manifest_v2.json
HEMOVET_MODEL_PATH=models/best_model_v2.pkl
HEMOVET_MODEL_METADATA_PATH=models/model_metadata_v2.json
HEMOVET_FEATURE_COLUMNS_PATH=data/processed/feature_columns.json
HEMOVET_THRESHOLDS_PATH=data/processed/decision_thresholds_v2.json
HEMOVET_IMPUTER_MEDIANS_PATH=data/processed/imputer_medians.csv
HEMOVET_LABEL_POLICY_PATH=data/processed/final_label_policy.json
HEMOVET_CALIBRATORS_PATH=models/calibrators_v2.pkl

# -----------------------------------------------------------------------------
# Extracción de hemogramas (OpenRouter, Gemini, fallback OCR local)
# -----------------------------------------------------------------------------
INSTALL_LOCAL_EXTRACTION=1
HEMOVET_ENABLE_LOCAL_EXTRACTION=1

# OpenRouter queda como respaldo opcional: los modelos gratis pueden ser lentos o rate-limited.
OPENROUTER_EXTRACTION_ENABLED=0
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GEMMA_MODEL=google/gemma-4-31b-it:free
OPENROUTER_NEMOTRON_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=hemogramas-proyectoICC
OPENROUTER_GEMMA_TIMEOUT_SECONDS=20
OPENROUTER_NEMOTRON_TIMEOUT_SECONDS=20

# Clave de Google Gemini usada para extracción remota cuando local no alcanza.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=90
GEMINI_EXTRACTION_TIMEOUT_SECONDS=20
GEMINI_FILE_POLL_SECONDS=2
GEMINI_FILE_POLL_MAX_ATTEMPTS=30
GEMINI_INLINE_TEXT_MAX_BYTES=200000
LOCAL_EXTRACTION_TIMEOUT_SECONDS=20
HEMOGRAM_EXTRACTION_TOTAL_TIMEOUT_SECONDS=60
HEMOGRAM_MIN_VALID_FIELDS=8

# -----------------------------------------------------------------------------
# Ollama / LLM local (RAG, fallback de Gemini)
# -----------------------------------------------------------------------------
# Dentro de Docker Compose, Ollama se accede por nombre de servicio, no localhost
OLLAMA_BASE_URL=http://ollama:11434/
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EXPECTED_MODEL_DIGEST=
OLLAMA_EXPECTED_QUANTIZATION=
# Opcional para runtimes compatibles protegidos; inyectar como secreto.
OLLAMA_API_KEY=

# Volumen persistente para evitar re-descargas al reiniciar el contenedor.
OLLAMA_MODELS_DIR=ollama-data

# Descargar/verificar automáticamente el modelo al iniciar si no existe.
# Recomendado en secrets/deploy para que el bootstrap de Ollama sea autónomo.
OLLAMA_AUTO_PULL=1
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_WRITE_TIMEOUT_SECONDS=15
OLLAMA_POOL_TIMEOUT_SECONDS=5
OLLAMA_HTTP_MAX_CONNECTIONS=8
OLLAMA_HTTP_MAX_KEEPALIVE_CONNECTIONS=4
OLLAMA_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
# HemoVet usa Qwen3 sin modo thinking para reducir latencia y evitar exponer razonamiento.
OLLAMA_THINK=0
OLLAMA_NUM_PREDICT=384
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
# Solo reintenta una conexión que no llegó a establecerse; nunca una lectura.
OLLAMA_MAX_RETRIES=1

# Variables del runtime Ollama local. La GPU usa deploy/gpu/compose.env.example.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=0
OLLAMA_KV_CACHE_TYPE=f16
OLLAMA_MAX_QUEUE=16
OLLAMA_WARMUP_ENABLED=1
OLLAMA_WARMUP_TIMEOUT_SECONDS=120
# Cada cuanto se comprueba que el runner residente sigue siendo el del perfil.
# La VM de la GPU carga el modelo con SU contexto al validar el arranque, y si
# reinicia bajo un backend vivo el warmup no se rehace: el desajuste lo paga el
# primer turno real, 101 s de mediana (n=5) contra 0,55 s de una llamada
# concordante. El intervalo es la ventana de exposicion, no un coste: cada
# pasada es un GET /api/ps.
# 0 = apagado. Lo esta desde el 9-ago-2026: el poll lanza TypeError cada 60 s
# en produccion y la causa sigue sin determinarse (ver salidas_fase21/02_m15.json).
# Se apaga en vez de revertirse para conservar el codigo y sus tres eventos.
OLLAMA_RUNNER_REALIGN_SECONDS=0
# `ollama` para la GPU local; `openai_compatible` para un runtime vLLM propio.
CHAT_LLM_PROVIDER=ollama
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=qwen3:8b
OPENAI_COMPATIBLE_API_KEY=

# -----------------------------------------------------------------------------
# RAG / base de conocimiento
# -----------------------------------------------------------------------------
CHROMA_HOST=chroma
CHROMA_PORT=8000
# Mantener en 0: Chroma corre por HTTP dentro de Docker Compose local.
CHROMA_SSL=0
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_PERSIST_DIRECTORY=/data
RAG_ENABLED=1
# Ruta versionada seleccionada para el runtime. Su ubicación no demuestra una
# revisión veterinaria independiente; esa evidencia debe auditarse por documento.
RAG_SOURCE_DIR=knowledge_base/expert_review/approved
RAG_COLLECTION_NAME=hemovet_canine_hematology_v2
RAG_SCHEMA_VERSION=hemovet-rag-v2
RAG_SOURCE_MANIFEST=knowledge_base/manifests/sources_manifest.json
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_MODEL_REVISION=fastembed-registry-0.8.0
RAG_EMBEDDING_POOLING_STRATEGY=mean
RAG_EMBEDDING_NORMALIZATION=true
RAG_EMBEDDING_DOCUMENT_PREFIX=
RAG_EMBEDDING_QUERY_PREFIX=
RAG_EMBEDDING_DIMENSION=384
RAG_EMBEDDING_CACHE_DIR=/app/.cache/fastembed
RAG_CHUNK_SIZE_WORDS=90
RAG_CHUNK_OVERLAP_WORDS=15
RAG_INGEST_BATCH_SIZE=64
RAG_FETCH_K=10
RAG_TOP_K=3
RAG_MIN_RELEVANCE_SCORE=0.38
RAG_BLOCKING_MAX_CONCURRENCY=2
RAG_MAX_CONTEXT_CHARS=3000
RAG_MAX_PER_SOURCE=2
RAG_RRF_K=60
# Mantener en 0: el RAG activo usa el corpus versionado seleccionado, no fixtures.
RAG_ALLOW_TEST_DOCUMENTS=0
RAG_ALLOW_AI_PROVISIONAL=0
RAG_ALLOWED_SPECIES=canine,canine_feline
RAG_ALLOWED_DOMAINS=hematology,clinical_pathology,coagulation,sample_collection,laboratory_methods,cytology
RAG_QUERY_MAX_VARIANTS=4
RAG_RERANKER_ENABLED=1
RAG_RERANKER_TOP_N=20
# Apagado por defecto: ayuda opcional de continuidad, no requerida por el
# invariante de RAG opcional.
RAG_NEIGHBOR_EXPANSION_ENABLED=0
RAG_NEIGHBOR_EXPANSION_MAX_CHUNKS=1
CHAT_MESSAGE_MAX_CHARS=2000
CHAT_STRUCTURED_OUTPUT_ENABLED=1
# El modelo pide con una herramienta los valores que necesita, en vez de
# recibir el panel entero en el prompt. Apagado: cambia la forma del turno y
# solo la batería puede decir si compensa en esta GPU.
CHAT_TOOLS_ENABLED=0
# Rondas de herramientas antes de obligar a responder. Tres bastan para
# listar estudios, leer un panel y corregir una llamada equivocada.
CHAT_TOOL_MAX_ROUNDS=3
# Compatibilidad local con clientes antiguos. El frontend actual siempre envía
# un UUIDv4 efímero guardado exclusivamente en sessionStorage.
CHAT_REQUIRE_BROWSER_SESSION_ID=0
CHAT_HISTORY_LIMIT=12
CHAT_SUMMARY_MAX_CHARS=3200
CHAT_SUMMARY_MAX_TOKENS=800
CHAT_MAX_INPUT_TOKENS=3200
CHAT_CONTEXT_RESERVE_TOKENS=256
# Overrides explícitos por modo; vacíos heredan OLLAMA_CONTEXT_LENGTH.
CHAT_PROFILE_GENERAL_CONTEXT_LENGTH=
CHAT_PROFILE_SELECTED_CONTEXT_LENGTH=
CHAT_PROFILE_HISTORY_CONTEXT_LENGTH=
# Temperatura por modo; vacíos heredan OLLAMA_TEMPERATURE. La lotería del
# validador vive en los caminos clínicos: menos varianza de redacción donde
# cada rechazo cuesta una regeneración entera.
CHAT_PROFILE_GENERAL_TEMPERATURE=
CHAT_PROFILE_SELECTED_TEMPERATURE=
CHAT_PROFILE_HISTORY_TEMPERATURE=
CHAT_REPAIR_CONTEXT_LENGTH=
CHAT_REPAIR_MAX_INPUT_TOKENS=
CHAT_REPAIR_NUM_PREDICT=512
CHAT_REPAIR_TEMPERATURE=0.1
CHAT_REPAIR_TOP_P=0.9
CHAT_REPAIR_TOP_K=40
CHAT_REPAIR_REPEAT_PENALTY=1.1
CHAT_REPAIR_THINK=0
# Diagnóstico puntual: directorio donde volcar cada envelope que el validador
# estructurado rechace, con el JSON completo del modelo. Escribe texto clínico
# a disco: se enciende para un diagnóstico y se apaga después. Vacío = apagado.
CHAT_STRUCTURED_DEBUG_DIR=
CHAT_MAX_GENERATION_ATTEMPTS=2
CHAT_REPAIR_MIN_REMAINING_SECONDS=30
CHAT_CLINICAL_FACT_MIN_COUNT=12
CHAT_CLINICAL_FACT_MAX_COUNT=64
CHAT_CLINICAL_FACT_TOKENS_PER_ITEM=96
# Cuantos parametros del hemograma puede ver el modelo en una pregunta
# amplia antes de que mande el presupuesto de tokens. Estaba fijo en 4
# dentro del codigo, por eso un estudio de 19 parametros llegaba con 4.
CHAT_CONTEXT_PARAMETER_LIMIT=24
CHAT_MEMORY_TOPIC_LIMIT=12
CHAT_MEMORY_RECENT_QUESTION_LIMIT=40
CHAT_MEMORY_CLINICAL_FACT_LIMIT=24
CHAT_MEMORY_SUMMARIZED_MESSAGE_ID_LIMIT=200
CHAT_MEMORY_ANSWER_EXCERPT_CHARS=420
CHAT_MEMORY_QUESTION_EXCERPT_CHARS=240
CHAT_MEMORY_SUMMARY_ENTRY_CHARS=260
CHAT_SESSION_TTL_SECONDS=3600
CHAT_TURN_LEASE_GRACE_SECONDS=5
CHAT_QUEUE_TIMEOUT_SECONDS=60
CHAT_TOTAL_TIMEOUT_SECONDS=240
CHAT_MAX_CONCURRENT_GENERATIONS=1
CHAT_DB_BLOCKING_MAX_CONCURRENCY=4
CHAT_STREAM_HEARTBEAT_SECONDS=15
# Ruta opcional al tokenizer.json exacto del modelo Qwen desplegado.
CHAT_TOKENIZER_JSON=
# SHA-256 opcional del archivo anterior; si se define, TokenCounter rechaza
# el arranque cuando el archivo cargado no coincide.
CHAT_TOKENIZER_SHA256=
# Local dev usa el modelo pequeño de arriba; el heurístico etiquetado sigue
# siendo válido aquí. El perfil cualificado de producción exige true.
CHAT_TOKENIZER_REQUIRED=0

# Verificación del soporte documental por entrañamiento (NLI) entre la oración
# inglesa del corpus y la afirmación en español. Apagado: con 0 el validador
# decide igual que hoy (coincidencia léxica más los vetos de cifras y de
# polaridad) y no se descarga ni se carga ningún modelo. Medido sobre las 70
# preguntas de backend/tests/data/bilingual_support_bench.jsonl con
# `python scripts/evaluate_support_bench.py --verifier {current,entailment}`:
# 46/70 con 11 aceptaciones inseguras apagado, 63/70 con 1 encendido.
CHAT_CLAIM_ENTAILMENT_ENABLED=0
# mDeBERTa-v3-base-XNLI entrena pares cuya premisa e hipótesis están en
# idiomas distintos, que es el caso de HemoVet. Su export ONNX corre sobre
# onnxruntime + tokenizers, que ya entran en la imagen como dependencias de
# fastembed: encenderlo no añade pila de inferencia, solo 1,1 GB de pesos que
# se bajan del Hub la primera vez.
CHAT_CLAIM_ENTAILMENT_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
# Donde se guardan esos 1,1 GB. Si no se monta como volumen, cada reinicio del
# contenedor vuelve a descargarlos.
CHAT_CLAIM_ENTAILMENT_CACHE_DIR=/app/.cache/entailment
# Calibrado sobre el banco: la afirmación fiel más débil entraña a 0,916 y
# todas las inseguras salvo una se quedan en 0,685 o menos, así que cualquier
# corte entre 0,69 y 0,91 puntúa igual. 0,80 está en el centro de esa meseta.
CHAT_CLAIM_ENTAILMENT_THRESHOLD=0.80
# Una inferencia midió 123 ms en CPU ociosa y 180-300 ms con la máquina
# ocupada. Pasarse de este plazo no rompe el turno: la afirmación vuelve al
# validador léxico.
CHAT_CLAIM_ENTAILMENT_TIMEOUT_SECONDS=2
# Hilos de ONNX Runtime por inferencia. Comparte CPU con la propia API, así
# que no se le dan todos los núcleos visibles; nunca usa GPU.
CHAT_CLAIM_ENTAILMENT_THREADS=2

# -----------------------------------------------------------------------------
# Mapa epidemiológico (privacidad por agregación geográfica)
# -----------------------------------------------------------------------------
MAP_MIN_ZONE_COUNT=3
MAP_MIN_DISTINCT_PETS=3
MAP_PUBLIC_GRID_DEGREES=0.03
MAP_AGGREGATION_GRID_DEGREES=0.02
RESIDENCE_GEOCODER_ENABLED=1
RESIDENCE_GEOCODER_TIMEOUT_SECONDS=8
RESIDENCE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
RESIDENCE_GEOCODER_USER_AGENT=HemoVet/2.1 community-surveillance
VETERINARY_PLACES_OVERPASS_URL=https://overpass-api.de/api/interpreter
VETERINARY_PLACES_TIMEOUT_SECONDS=8

# -----------------------------------------------------------------------------
# Fotos y archivos
# -----------------------------------------------------------------------------
PET_MEDIA_DIR=backend/media
PET_PHOTO_MAX_BYTES=5242880
HEMOGRAM_FILE_MAX_BYTES=10485760

# -----------------------------------------------------------------------------
# Frontend / Vite (se inyectan en tiempo de build de la imagen Docker)
# -----------------------------------------------------------------------------
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_API_BASE_URL=/api/v1
VITE_CHAT_MESSAGE_MAX_CHARS=2000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
