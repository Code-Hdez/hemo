{
  "$defs": {
    "ApplicationRelease": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/ImmutableImage"
        },
        "caddy_configuration_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Caddy Configuration Digest",
          "type": "string"
        },
        "configuration_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Configuration Digest",
          "type": "string"
        },
        "frontend": {
          "$ref": "#/$defs/ImmutableImage"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "backend",
        "frontend",
        "configuration_digest",
        "caddy_configuration_digest"
      ],
      "title": "ApplicationRelease",
      "type": "object"
    },
    "GpuRuntimeRelease": {
      "additionalProperties": false,
      "properties": {
        "apply_on": {
          "const": "next_boot",
          "title": "Apply On",
          "type": "string"
        },
        "initial_validation_state": {
          "const": "pending_boot_validation",
          "title": "Initial Validation State",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelRelease"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/ImmutableImage"
        },
        "startup_bundle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Startup Bundle Digest",
          "type": "string"
        },
        "startup_contract_version": {
          "maxLength": 100,
          "minLength": 3,
          "title": "Startup Contract Version",
          "type": "string"
        },
        "update_while_running": {
          "const": false,
          "title": "Update While Running",
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "runtime",
        "startup_bundle_digest",
        "startup_contract_version",
        "model",
        "apply_on",
        "initial_validation_state",
        "update_while_running"
      ],
      "title": "GpuRuntimeRelease",
      "type": "object"
    },
    "ImmutableImage": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "reference": {
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "title": "Reference",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "digest"
      ],
      "title": "ImmutableImage",
      "type": "object"
    },
    "ModelRelease": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "quantization": {
          "pattern": "^[A-Za-z0-9_]{2,32}$",
          "title": "Quantization",
          "type": "string"
        }
      },
      "required": [
        "name",
        "digest",
        "quantization"
      ],
      "title": "ModelRelease",
      "type": "object"
    },
    "RagRelease": {
      "additionalProperties": false,
      "properties": {
        "collection_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
          "title": "Collection Name",
          "type": "string"
        },
        "corpus_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Corpus Revision",
          "type": "string"
        },
        "embedding_model": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Embedding Revision",
          "type": "string"
        },
        "index_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Index Fingerprint",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "schema_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "required",
        "collection_name",
        "corpus_revision",
        "index_fingerprint",
        "schema_version",
        "embedding_model",
        "embedding_revision"
      ],
      "title": "RagRelease",
      "type": "object"
    },
    "ReleaseContractVersions": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "const": "hemovet.availability/v1",
          "title": "Availability",
          "type": "string"
        },
        "llm_provider": {
          "const": "hemovet.llm-provider/v1",
          "title": "Llm Provider",
          "type": "string"
        },
        "release_manifest": {
          "const": "hemovet.release/v1",
          "title": "Release Manifest",
          "type": "string"
        }
      },
      "required": [
        "release_manifest",
        "availability",
        "llm_provider"
      ],
      "title": "ReleaseContractVersions",
      "type": "object"
    },
    "ReleaseSource": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "github_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Github Sha",
          "type": "string"
        },
        "repository": {
          "maxLength": 200,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "workflow_run_attempt": {
          "minimum": 1,
          "title": "Workflow Run Attempt",
          "type": "integer"
        },
        "workflow_run_id": {
          "minimum": 1,
          "title": "Workflow Run Id",
          "type": "integer"
        }
      },
      "required": [
        "github_sha",
        "repository",
        "workflow_run_id",
        "workflow_run_attempt",
        "created_at"
      ],
      "title": "ReleaseSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "application": {
      "$ref": "#/$defs/ApplicationRelease"
    },
    "contracts": {
      "$ref": "#/$defs/ReleaseContractVersions"
    },
    "gpu_runtime": {
      "$ref": "#/$defs/GpuRuntimeRelease"
    },
    "rag": {
      "$ref": "#/$defs/RagRelease"
    },
    "release_id": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "hemovet.release/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ReleaseSource"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "source",
    "application",
    "gpu_runtime",
    "rag",
    "contracts"
  ],
  "title": "ReleaseManifest",
  "type": "object"
}
