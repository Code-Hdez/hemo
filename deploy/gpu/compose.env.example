# Valores no sensibles para renderizar docker-compose.gpu.yml.
# OLLAMA_BIND_ADDRESS se verificó como IP privada de hemovet-llm-gpu en la
# línea base. Debe volverse a comprobar antes de aplicar el runtime.
#
# Etapa de cierre operativo: Qwen3.6 27B Q4_K_M fue instalado y verificado
# manualmente en hemovet-llm-gpu (digest real vía `ollama show`, 100% GPU,
# contexto 65536 residente en la L4 de 24 GB). runtime_contract.py ya declara
# este modelo como APPROVED_MODEL/APPROVED_MODEL_DIGEST/APPROVED_QUANTIZATION.
# Este archivo refleja esa misma identidad; en producción real el release se
# genera automáticamente por el pipeline (prepare_release.py/
# project_gpu_release.py) a partir del commit desplegado, no de este ejemplo.
HEMOVET_OLLAMA_RUNTIME_IMAGE=us-central1-docker.pkg.dev/project-5b36701c-f44f-4c03-a12/hemovet-images/ollama-runtime@sha256:b526b1d4bc30d0cc641e0d2a186034b327c97de0171b1a47ce1c917d79604e5f
HEMOVET_GPU_RELEASE_ID=515d343ac805779f94be9277376bdadf5516154d
HEMOVET_GPU_RUNTIME_DIGEST=sha256:b526b1d4bc30d0cc641e0d2a186034b327c97de0171b1a47ce1c917d79604e5f
OLLAMA_BIND_ADDRESS=10.128.0.3
OLLAMA_MODEL=qwen3.6:27b-q4_K_M
OLLAMA_EXPECTED_MODEL_DIGEST=a50eda8ed977ab48a12431878896b27ffd5cef552c17af3317d9623b939a7f1e
OLLAMA_EXPECTED_QUANTIZATION=Q4_K_M
OLLAMA_AUTO_PULL=1
OLLAMA_KEEP_ALIVE=-1
OLLAMA_CONTEXT_LENGTH=65536
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=32
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
